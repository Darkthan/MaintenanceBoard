<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MaintenanceBoard Agent" Manufacturer="MaintenanceBoard"
           Version="1.0.1" UpgradeCode="A697AB8B-4A63-43E5-8E8E-7E8EDCB4E390"
           Scope="perMachine" Language="1036">
    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de MaintenanceBoard Agent est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Le serveur remplace ces deux valeurs dans une copie du MSI pour chaque jeton. -->
    <Property Id="SERVERURL" Value="https://maintenanceboard.invalid" Secure="yes" />
    <Property Id="ENROLLMENTTOKEN" Value="00000000-0000-0000-0000-000000000000" Secure="yes" Hidden="yes" />
    <Launch Condition="Installed OR (SERVERURL AND ENROLLMENTTOKEN)"
            Message="L'URL du serveur et le jeton d'enrôlement sont requis." />

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AgentDir" Name="MaintenanceBoardAgent" />
    </StandardDirectory>

    <Component Id="AgentFile" Directory="AgentDir" Guid="*">
      <File Id="AgentScript" Source="downloads/templates/agent.ps1" KeyPath="yes" />
    </Component>
    <Component Id="ConfigureFile" Directory="AgentDir" Guid="*">
      <File Id="ConfigureScript" Source="installer/configure-agent.ps1" />
    </Component>

    <Feature Id="Main" Title="MaintenanceBoard Agent" Level="1">
      <ComponentRef Id="AgentFile" />
      <ComponentRef Id="ConfigureFile" />
    </Feature>

    <CustomAction Id="ConfigureAgent" Directory="AgentDir"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[AgentDir]configure-agent.ps1&quot; -ServerUrl &quot;[SERVERURL]&quot; -EnrollmentToken &quot;[ENROLLMENTTOKEN]&quot;"
                  Execute="deferred" Impersonate="no" Return="check" HideTarget="yes" />
    <CustomAction Id="RemoveAgentTask" Directory="AgentDir"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[AgentDir]configure-agent.ps1&quot; -Uninstall"
                  Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="ConfigureAgent" After="InstallFiles" Condition="NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="RemoveAgentTask" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
